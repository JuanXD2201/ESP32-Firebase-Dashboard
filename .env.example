# Copia a backend/.env (el archivo real NO se sube a git).

# firestore | memoria  (memoria = pruebas sin Firebase; se borra al reiniciar)
STORAGE=memoria

# ID técnico del proyecto Firebase (Configuración del proyecto > ID del proyecto)
FIREBASE_PROJECT_ID=

# Credenciales: ruta a la clave JSON de la cuenta de servicio (guárdala FUERA del repositorio)
# o deja vacío para usar Application Default Credentials (gcloud auth application-default login).
GOOGLE_APPLICATION_CREDENTIALS=

FIRESTORE_COLLECTION=lecturas

# Si se define, POST /api/lecturas exige el header X-API-Key con este valor.
# Genera una: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=

# Orígenes CORS permitidos, separados por coma (en producción: la URL del dashboard).
CORS_ORIGINS=*

MAX_LIMIT=500
PORT=5000
